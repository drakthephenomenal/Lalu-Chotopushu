{
  "name": "radha-naam-jap",
  "version": "1.0.0",
  "private": true,
  "description": "RadhaNaam SudhaRasam - Panchanga / mala counter app (Capacitor Android wrapper)",
  "scripts": {
    "www": "bash setup-www.sh",
    "sync": "bash setup-www.sh && npx cap sync android",
    "open:android": "npx cap open android",
    "build:apk": "bash build-android.sh",
    "build:apk:keep": "bash build-android.sh --keep",
    "build:apk:release": "bash setup-www.sh && npx cap sync android && cd android && ./gradlew assembleRelease",
    "build:aab": "bash setup-www.sh && npx cap sync android && cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.0.0",
    "@capacitor-firebase/messaging": "^8.0.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/background-runner": "latest",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/share": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.0"
  },
  "allowScripts": {
    "sharp@0.32.6": true
  },
  "engines": {
    "node": ">=22"
  }
}
