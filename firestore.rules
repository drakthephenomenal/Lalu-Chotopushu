rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isDeveloper() {
      return request.auth != null && request.auth.token.email in [
        'drakthephenomenal@gmail.com',
        'akthephenomenal@zohomail.com',
        'drakthephenomenal@proton.me',
        'anupkumarpaulshuvo@gmail.com'
      ];
    }

    // User data: owner reads+writes, developer reads only (ghost mode)
    match /users/{userId}/{document=**} {
      allow read:  if request.auth != null
        && (request.auth.uid == userId || isDeveloper());
      allow write: if request.auth != null
        && request.auth.uid == userId;
    }

    // Mala archive: one doc per day per user
    // users/{uid}/malaArchive/{YYYY-MM-DD}
    match /users/{userId}/malaArchive/{date} {
      allow read:  if request.auth != null
        && (request.auth.uid == userId || isDeveloper());
      allow write: if request.auth != null
        && request.auth.uid == userId;
    }

    match /_timesync/{doc} {
      allow read, write: if request.auth != null;
    }

    match /leaderboard/{userId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /feedbacks/{userId} {
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid;
      allow read: if request.auth != null
        && (request.auth.uid == userId || isDeveloper());
      allow update: if isDeveloper()
        || (request.auth != null
            && request.auth.uid == userId
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly([
                   'lastMessage', 'lastAt', 'devRead',
                   'userName', 'userPhone', 'userEmail',
                   'userRead'
                 ]));
      allow delete: if isDeveloper();
      match /messages/{msgId} {
        allow read: if request.auth != null
          && (request.auth.uid == userId || isDeveloper());
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.sender == 'user';
        allow create: if isDeveloper()
          && request.resource.data.sender == 'developer';
        allow update, delete: if isDeveloper();
      }
    }
  }
}
