rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isDeveloper() {
      return request.auth != null && request.auth.token.email in [
        'drakthephenomenal@gmail.com',
        'akthephenomenal@zohomail.com',
        'anupkumarpaulshuvo@gmail.com'
      ];
    }

    // User's own data — full access
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    // Global stotrams — any user can read, only developer can write
    match /global_stotrams/{docId} {
      allow read: if true;
      allow write: if isDeveloper();
    }

    // Stotram lyrics overrides — any user can read, only developer can write
    match /stotram_overrides/{docId} {
      allow read: if true;
      allow write: if isDeveloper();
    }

    // Per-stotram YouTube links — any user can read, only developer can write
    match /stotram_youtube_links/{docId} {
      allow read: if true;
      allow write: if isDeveloper();
    }

    // Time sync probe — needed for fbSyncServerTime()
    match /_timesync/{doc} {
      allow read, write: if request.auth != null;
    }

    // Leaderboard — any signed-in user can read, user can only update their own rank
    match /leaderboard/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // User feedbacks — any signed-in user can submit, only developer can read
    match /feedbacks/{docId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isDeveloper();
    }

    // Global notifications — any user can read (for bell icon), only developer can write
    match /notifications/{docId} {
      allow read: if true;
      allow write: if isDeveloper();
    }

    // Global app config (video link etc.) — any user can read, only developer can write
    match /global_config/{docId} {
      allow read: if true;
      allow write: if isDeveloper();
    }
  }
}
